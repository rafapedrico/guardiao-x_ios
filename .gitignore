# Flutter
.dart_tool/
.packages
build/
*.iml
.idea/
.vscode/
*.lock
# Exceções: em APP (não pacote) o Flutter recomenda versionar os locks,
# para o CI não pegar versões novas de dependências sem a gente saber.
# O ios/Podfile.lock só é gerado no macOS — o ios-build.yml publica o
# gerado no CI como artifact ("Podfile.lock") para ser commitado.
!/pubspec.lock
!/ios/Podfile.lock

# Android
android/.gradle/
android/app/build/
android/build/
local.properties

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# macOS
macos/Pods/
macos/.symlinks/

# Web
web/build/

# General
.DS_Store
*.swp
*.swo

# Artefato gerado automaticamente pelo flutter gen-l10n (relatório de
# strings ainda não traduzidas) — não é código-fonte.
untranslated_messages.json

# Código gerado pelo flutter gen-l10n (ver l10n.yaml/pubspec.yaml
# `generate: true`) — a partir do Flutter 3.44+, que removeu o suporte
# ao "pacote sintético" flutter_gen, esses arquivos passaram a ser
# escritos direto em lib/l10n/ em vez de .dart_tool/ (que já era
# ignorado). Continuam sendo gerados automaticamente a cada
# `flutter pub get`/build — nunca precisam ser versionados.
lib/l10n/app_localizations.dart
lib/l10n/app_localizations_*.dart

# Firebase Cloud Functions
functions/node_modules/
functions/lib/
.firebase/
firebase-debug.log

# Painel Web de Admin (admin/, Vite+React)
admin/node_modules/
admin/dist/
firebase-debug.*.log