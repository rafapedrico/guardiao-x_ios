<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Distribuição App Store Connect/TestFlight (ios-testflight.yml).
	     Substitui o antigo perfil Ad Hoc "GuardiaoX_AdHoc_CI": a assinatura
	     agora é automática, com certificado/profile gerenciados na nuvem
	     via App Store Connect API Key (-allowProvisioningUpdates). -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>SW48YVGJZ7</string>

	<!-- Só exporta o .ipa; o upload é feito num passo separado (altool),
	     para o .ipa também ficar salvo como artifact do workflow. -->
	<key>destination</key>
	<string>export</string>

	<!-- O número de build vem do workflow (run_number + 100); não deixar
	     o Xcode reescrever. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>uploadSymbols</key>
	<true/>
	<key>stripSwiftSymbols</key>
	<true/>
</dict>
</plist>
