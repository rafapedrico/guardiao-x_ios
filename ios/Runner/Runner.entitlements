<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Necessário para o firebase_messaging (Push FCM App-para-App / alerta
	     híbrido) funcionar no iOS. Na exportação app-store-connect
	     (ios-testflight.yml) o Xcode troca sozinho para "production" ao
	     re-assinar com o profile de distribuição. "development" aqui; ao gerar o build de
	     produção/App Store no Xcode, troque para "production" (ou deixe o
	     Xcode trocar automaticamente ao usar um perfil de distribuição). -->
	<key>aps-environment</key>
	<string>development</string>

	<!-- Faltava: o app usa sign_in_with_apple (pubspec.yaml) mas essa
	     capability nunca foi declarada aqui. Não dava problema nos builds
	     sem assinatura (flag no_codesign do flutter build) porque
	     entitlements não são checados sem assinatura real — mas num .ipa
	     assinado de verdade isso quebraria o Sign in with Apple em
	     runtime. Adicionado em 2026-09-13 ao preparar o pipeline de
	     assinatura/release. Precisa também estar habilitado como
	     capability no App ID no portal da Apple Developer. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>

	<!-- Alertas de emergência recebidos via Push (bloco apns com
	     "interruption-level": "time-sensitive", ver functions/apnsPayload.js)
	     e notificações locais InterruptionLevel.timeSensitive: sem este
	     entitlement o iOS rebaixa para "active" e o aviso não fura o Foco. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>

	<!-- Universal Link do Programa de Indicação
	     (https://meuguardiaox.com.br/i/{CODIGO}, ver IndicacaoLinkPlugin no
	     SceneDelegate.swift). Só abre o app depois que o site publicar
	     /.well-known/apple-app-site-association com
	     SW48YVGJZ7.com.rmfglobal.guardiaox e a rota /i/*. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:meuguardiaox.com.br</string>
	</array>
</dict>
</plist>
