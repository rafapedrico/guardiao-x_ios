# Versão mínima de deployment do app — mantida em sincronia com
# IPHONEOS_DEPLOYMENT_TARGET no Runner.xcodeproj/project.pbxproj (3
# ocorrências, nível de projeto). Não deixe este valor descoberto/comentado:
# sem ele, o CocoaPods calcula o alvo do agregado "Pods" pelo MÍNIMO
# declarado entre todas as dependências — e pods transitivos do Firebase
# (ex: BoringSSL-GRPC, nanopb, gRPC-Core) ainda declaram iOS 9.0/10.0 como
# mínimo em seus próprios podspecs.
#
# NOTA: isso sozinho NÃO resolve o "unsupported option '-G' for target
# 'arm64-apple-iosX.0'" (confirmado no CI: o erro persistiu idêntico,
# só trocando 10.0 por 15.0 no nome do target) — "-G" é uma flag GCC
# obsoleta (small-data section, de toolchains embarcados antigos) que
# algum pod transitivo injeta direto em OTHER_CFLAGS/afins, independente
# do deployment target. A remoção real dessa flag está no post_install
# abaixo. Mesmo assim vale manter a versão alta aqui: evita outros
# avisos/erros de compatibilidade com o SDK atual do Firebase.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# Remove qualquer ocorrência da flag "-G" (e variantes coladas tipo "-G0",
# "-G8") de uma configuração de build de flags de compilador/linker. Aceita
# tanto Array (formato mais comum no Xcodeproj gerado pelo CocoaPods)
# quanto String (alguns podspecs escrevem um valor único), para não deixar
# passar nenhuma das duas representações.
def remover_flag_g_obsoleta(valor)
  return valor if valor.nil?

  if valor.is_a?(Array)
    valor.reject { |flag| flag =~ /\A-G\d*\z/ }
  else
    valor.to_s.split(/\s+/).reject { |flag| flag =~ /\A-G\d*\z/ }.join(' ')
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Força o deployment target de TODOS os pods (inclusive
      # dependências transitivas que o flutter_additional_ios_build_settings
      # acima não sobe, por declararem a própria versão mínima abaixo de
      # 13.0 — ver comentário no topo do arquivo).
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # Causa raiz real do "unsupported option '-G' for target
      # 'arm64-apple-iosX.0'": algum pod transitivo do Firebase/gRPC
      # (ex: abseil, BoringSSL-GRPC) ainda injeta a flag GCC obsoleta
      # "-G" (small-data section, de toolchains embarcados antigos) em
      # OTHER_CFLAGS/OTHER_CPLUSPLUSFLAGS/OTHER_LDFLAGS — o clang do
      # Xcode moderno rejeita, não importa o deployment target.
      ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS', 'OTHER_LDFLAGS'].each do |flag_key|
        proximo_valor = remover_flag_g_obsoleta(config.build_settings[flag_key])
        config.build_settings[flag_key] = proximo_valor unless proximo_valor.nil?
      end
    end

    # A primeira tentativa (só OTHER_CFLAGS/afins no nível do target) não
    # bastou — o erro persistiu idêntico. Motivo: alguns podspecs aplicam
    # "-G" como flag DE ARQUIVO individual (COMPILER_FLAGS por
    # PBXBuildFile, via `compiler_flags`/`source_files` no .podspec), que
    # é uma configuração separada de OTHER_CFLAGS do target e não é
    # tocada pelo loop acima. Varre TODAS as build phases de TODO pod
    # (compile sources, headers, etc.) e limpa a flag em cada arquivo.
    target.build_phases.each do |phase|
      next unless phase.respond_to?(:files)

      phase.files.each do |file|
        next unless file.settings && file.settings['COMPILER_FLAGS']

        file.settings['COMPILER_FLAGS'] =
          remover_flag_g_obsoleta(file.settings['COMPILER_FLAGS'])
      end
    end
  end
end
