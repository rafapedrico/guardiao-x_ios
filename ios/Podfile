# Versão mínima de deployment do app — mantida em sincronia com
# IPHONEOS_DEPLOYMENT_TARGET no Runner.xcodeproj/project.pbxproj (3
# ocorrências, nível de projeto). Não deixe este valor descoberto/comentado:
# sem ele, o CocoaPods calcula o alvo do agregado "Pods" pelo MÍNIMO
# declarado entre todas as dependências — e pods transitivos do Firebase
# (ex: BoringSSL-GRPC, nanopb, gRPC-Core) ainda declaram iOS 9.0/10.0 como
# mínimo em seus próprios podspecs.
#
# NOTA: isso sozinho NÃO resolve o "unsupported option '-G' for target
# 'arm64-apple-iosX.0'" (confirmado no CI: o erro persistiu idêntico, só
# trocando 10.0 por 15.0 no nome do target). Causa raiz REAL, confirmada
# lendo o log bruto do xcodebuild (2026-09-13, ver job de diagnóstico no
# workflow): bug no podspec do pod BoringSSL-GRPC — ele quis setar a
# build setting `GCC_WARN_INHIBIT_ALL_WARNINGS = YES`, mas colou ela
# dentro de OTHER_CFLAGS como se fosse uma flag de linha de comando, com
# um "-" na frente ("-GCC_WARN_INHIBIT_ALL_WARNINGS"). O clang reconhece
# o prefixo "-G" (do antigo "-G<num>" de toolchains embarcados) e rejeita
# o resto do token — por isso o erro mostra só "-G", nunca o nome
# completo. A remoção real está no post_install abaixo (ver
# remover_flag_g_obsoleta). Mesmo assim vale manter a versão alta aqui:
# evita outros avisos/erros de compatibilidade com o SDK atual do
# Firebase.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# Remove qualquer flag de compilador que comece com "-G" (formato "-G",
# "-G0"/"-G8", ou colada com o nome de uma build setting, ex:
# "-GCC_WARN_INHIBIT_ALL_WARNINGS"). Essa última é a causa raiz REAL e
# confirmada (log bruto do xcodebuild, 2026-09-13) do "unsupported option
# '-G' for target 'arm64-apple-iosX.0'": o podspec do pod BoringSSL-GRPC
# (dependência do gRPC/Firestore/Functions) tem um bug — quis setar a
# build setting `GCC_WARN_INHIBIT_ALL_WARNINGS = YES`, mas colou ela como
# se fosse uma flag de linha de comando dentro de OTHER_CFLAGS, com um "-"
# na frente. O clang reconhece o prefixo "-G" (do antigo "-G<num>" de
# toolchains embarcados) e rejeita o resto do token — por isso o erro
# mostra só "-G", nunca o nome completo. A primeira tentativa de filtro
# aqui (regex \A-G\d*\z, só "-G" ou "-G" + dígitos) não pegava esse caso
# por ser letras/underscore, não dígitos — daí o erro persistir idêntico
# depois do primeiro fix. Aceita tanto Array (formato mais comum no
# Xcodeproj gerado pelo CocoaPods) quanto String (alguns podspecs
# escrevem um valor único).
def remover_flag_g_obsoleta(valor)
  return valor if valor.nil?

  if valor.is_a?(Array)
    valor.reject { |flag| flag =~ /\A-G\w*\z/ }
  else
    valor.to_s.split(/\s+/).reject { |flag| flag =~ /\A-G\w*\z/ }.join(' ')
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Força o deployment target de TODOS os pods (inclusive
      # dependências transitivas que o flutter_additional_ios_build_settings
      # acima não sobe, por declararem a própria versão mínima abaixo de
      # 13.0 — ver comentário no topo do arquivo).
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # Causa raiz real e confirmada do "unsupported option '-G' for
      # target 'arm64-apple-iosX.0'": bug no podspec do BoringSSL-GRPC,
      # que injeta "-GCC_WARN_INHIBIT_ALL_WARNINGS" em OTHER_CFLAGS (ver
      # comentário completo no topo do arquivo e em
      # remover_flag_g_obsoleta).
      ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS', 'OTHER_LDFLAGS'].each do |flag_key|
        proximo_valor = remover_flag_g_obsoleta(config.build_settings[flag_key])
        config.build_settings[flag_key] = proximo_valor unless proximo_valor.nil?
      end
    end

    # Camada extra de segurança (não é a causa confirmada, mas é grátis e
    # cobre o caso — não confirmado neste projeto — de algum pod aplicar
    # "-G..." como flag DE ARQUIVO individual, via COMPILER_FLAGS em
    # PBXBuildFile, que é uma configuração separada de OTHER_CFLAGS do
    # target e não seria tocada pelo loop acima).
    target.build_phases.each do |phase|
      next unless phase.respond_to?(:files)

      phase.files.each do |file|
        next unless file.settings && file.settings['COMPILER_FLAGS']

        file.settings['COMPILER_FLAGS'] =
          remover_flag_g_obsoleta(file.settings['COMPILER_FLAGS'])
      end
    end
  end
end
